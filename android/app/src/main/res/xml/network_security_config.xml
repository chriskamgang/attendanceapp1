<?xml version="1.0" encoding="utf-8"?>
<!--
    Le trafic en clair reste interdit par défaut : la production des deux
    espaces est en HTTPS, et doit le rester.

    L'exception ci-dessous vise le seul poste de développement, le temps de
    l'intégration d'INSAM BUS (backend lancé par ./server.sh sur le port
    8001). Elle est à retirer — ou à laisser sans effet — une fois l'espace
    bus repassé sur son serveur de production.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <domain-config cleartextTrafficPermitted="true">
        <!-- Poste de développement sur le réseau local. -->
        <domain includeSubdomains="false">192.168.3.237</domain>

        <!-- Émulateur Android : l'hôte s'y atteint par cette adresse. -->
        <domain includeSubdomains="false">10.0.2.2</domain>

        <!-- Boucle locale, pour un backend lancé sur l'appareil même. -->
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
